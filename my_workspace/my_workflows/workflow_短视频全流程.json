{
  "workflow_id": "workflow_短视频全流程",
  "name": "短视频全流程",
  "description": "从用户原始想法到短视频 brief、编导方案、口播脚本、标题封面和合规审核的完整流程。",
  "input_required": [
    "内容主题或产品信息",
    "目标平台",
    "目标用户",
    "发布目的",
    "可用素材",
    "禁用表达或行业限制"
  ],
  "steps": [
    {
      "step": 1,
      "agent": "01_需求拆解专员",
      "task": "把原始需求拆成内容需求拆解 Brief。",
      "output": "内容需求拆解 Brief"
    },
    {
      "step": 2,
      "agent": "02_短视频编导",
      "task": "根据 Brief 生成短视频编导方案、镜头结构和拍摄清单。",
      "output": "短视频编导方案"
    },
    {
      "step": 3,
      "agent": "03_口播脚本师",
      "task": "根据 Brief 和编导方案生成完整口播稿、字幕版和备选开头结尾。",
      "output": "口播脚本"
    },
    {
      "step": 4,
      "agent": "04_标题封面优化师",
      "task": "生成标题候选、封面文案、平台标签和推荐版本。",
      "output": "标题封面优化方案"
    },
    {
      "step": 5,
      "agent": "05_内容合规审核官",
      "task": "审核脚本、标题、封面和发布表达，输出风险清单和修改建议。",
      "output": "内容合规审核报告"
    }
  ],
  "final_outputs": [
    "内容需求拆解 Brief",
    "短视频编导方案",
    "口播脚本",
    "标题封面优化方案",
    "内容合规审核报告"
  ],
  "acceptance_criteria": [
    "能直接进入拍摄和剪辑",
    "标题封面有可测试版本",
    "脚本适合真人口播",
    "发布前合规风险已处理"
  ]
}
