{
  "workflow_id": "workflow_开发外包",
  "name": "开发外包获客内容",
  "description": "面向软件开发、AI 自动化、网站建设、系统外包等服务的短视频和图文获客流程。",
  "input_required": [
    "服务类型",
    "目标客户行业",
    "客户常见痛点",
    "案例或能力证明",
    "期望转化动作",
    "不能公开的信息"
  ],
  "steps": [
    {
      "step": 1,
      "agent": "01_需求拆解专员",
      "task": "拆解服务卖点、客户痛点、案例边界和转化路径。",
      "output": "开发外包内容 Brief"
    },
    {
      "step": 2,
      "agent": "02_短视频编导",
      "task": "设计获客型短视频结构，突出问题、方案、案例和信任证明。",
      "output": "获客短视频编导方案"
    },
    {
      "step": 3,
      "agent": "03_口播脚本师",
      "task": "生成适合老板、创业者或业务负责人的口播脚本。",
      "output": "获客口播脚本"
    },
    {
      "step": 4,
      "agent": "04_标题封面优化师",
      "task": "生成痛点型、案例型、避坑型和报价认知型标题封面。",
      "output": "获客标题封面方案"
    },
    {
      "step": 5,
      "agent": "05_内容合规审核官",
      "task": "审核案例真实性、客户隐私、效果承诺、价格承诺和导流表达。",
      "output": "获客内容合规审核报告"
    }
  ],
  "final_outputs": [
    "开发外包内容 Brief",
    "获客短视频编导方案",
    "获客口播脚本",
    "获客标题封面方案",
    "获客内容合规审核报告"
  ],
  "acceptance_criteria": [
    "能清楚说明服务价值",
    "能筛选出有效客户",
    "案例表达不泄露客户隐私",
    "转化动作明确但不过度导流"
  ]
}
