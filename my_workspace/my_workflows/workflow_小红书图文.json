{
  "workflow_id": "workflow_小红书图文",
  "name": "小红书图文",
  "description": "面向小红书图文笔记的选题、正文、封面标题、标签和合规审核流程。",
  "input_required": [
    "笔记主题",
    "产品或经验内容",
    "目标人群",
    "账号调性",
    "图片素材或拍摄条件",
    "转化目标"
  ],
  "steps": [
    {
      "step": 1,
      "agent": "01_需求拆解专员",
      "task": "明确小红书笔记目标、用户痛点、内容角度和素材清单。",
      "output": "小红书图文 Brief"
    },
    {
      "step": 2,
      "agent": "03_口播脚本师",
      "task": "将口播能力用于图文正文，生成口语化、真实感强的笔记正文。",
      "output": "图文正文草稿"
    },
    {
      "step": 3,
      "agent": "04_标题封面优化师",
      "task": "生成小红书标题、封面文字、图片页结构、关键词和标签。",
      "output": "标题封面与标签方案"
    },
    {
      "step": 4,
      "agent": "05_内容合规审核官",
      "task": "审核标题党、功效承诺、导流、素材版权和平台敏感表达。",
      "output": "图文合规审核报告"
    }
  ],
  "final_outputs": [
    "小红书图文 Brief",
    "图文正文草稿",
    "标题封面与标签方案",
    "图文合规审核报告"
  ],
  "acceptance_criteria": [
    "标题适合小红书搜索和推荐",
    "正文像真实分享而非硬广",
    "封面文字简短清晰",
    "标签和关键词可直接发布使用"
  ]
}
